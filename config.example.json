{
  "version": 1,
  "window": {
    "mode": "desktop",
    "display": "portrait",
    "width": 1280,
    "height": 900,
    "alwaysOnTop": false,
    "preventSleep": false
  },
  "usage": {
    "codex": "local",
    "claude": "local"
  },
  "codex": {
    "enabled": true,
    "home": "~/.codex",
    "binary": ""
  },
  "codexAccounts": [
    {
      "id": "codex-1",
      "name": "Codex",
      "codexHome": "~/.codex"
    }
  ],
  "claude": {
    "enabled": false,
    "managedCollector": true,
    "quota": true,
    "projects": "~/.claude/projects",
    "expectedSources": [
      "local"
    ]
  },
  "opencodex": {
    "hubUrl": "",
    "adminToken": ""
  },
  "t3": {
    "enabled": false,
    "database": "~/.t3/userdata/state.sqlite",
    "remotes": [],
    "readState": {}
  },
  "forge": {
    "enabled": false
  },
  "pollSeconds": 300
}
