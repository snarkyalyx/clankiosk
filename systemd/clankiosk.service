[Unit]
Description=Clankiosk AI activity dashboard
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/clankiosk
ExecStart=%h/clankiosk/node_modules/electron/dist/electron %h/clankiosk --kiosk
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
